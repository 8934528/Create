@page
@model frontend_web.Pages.RegisterModel
@{
    ViewData["Title"] = "Face Enrollment";
}

<div class="container-fluid p-0 vh-100 overflow-hidden bg-white">
    <div class="row g-0 h-100">

        <!-- Left Column: Camera -->
        <div class="col-lg-7 bg-light d-flex align-items-center justify-content-center p-0 position-relative reduced-height-col overflow-hidden">
            <video id="video" class="w-100 h-100" style="object-fit: cover; transform: scaleX(-1); background: #000;" autoplay></video>
            <canvas id="canvas" style="display:none;"></canvas>
            
            <div class="position-absolute top-50 start-50 translate-middle w-75 h-75 border rounded-circle" style="pointer-events: none; border: 3px dashed rgba(255, 255, 255, 0.6) !important; box-shadow: 0 0 0 1000px rgba(0,0,0,0.4);">
            </div>
            
            <div class="position-absolute bottom-0 start-0 w-100 p-4 bg-gradient-dark text-white text-center d-none d-lg-block">
                <small><i class="fi fi-rr-info me-1"></i> Ensure your face is clearly visible and centered in the circle.</small>
            </div>
        </div>
        
        <!-- Right Column: Form -->
        <div class="col-lg-5 d-flex flex-column p-5 border-end reduced-height-col">
            <div class="mb-4">
                <h2 class="fw-bold text-primary mb-1">
                    <i class="fi fi-rr-user-add me-2"></i> Face Enrollment
                </h2>
                <p class="text-muted small d-none d-lg-block">Register your biometric ID for secure attendance tracking.</p>
            </div>
            
            <div class="flex-grow-1">
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-2">Full Name</label>
                    <div class="input-group border rounded-3 bg-light p-1">
                        <span class="input-group-text bg-transparent border-0"><i class="fi fi-rr-user text-muted"></i></span>
                        <input id="name" class="form-control border-0 bg-transparent shadow-none py-1" placeholder="Full Name" />
                    </div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-2">Email Address</label>
                    <div class="input-group border rounded-3 bg-light p-1">
                        <span class="input-group-text bg-transparent border-0"><i class="fi fi-rr-envelope text-muted"></i></span>
                        <input id="email" type="email" class="form-control border-0 bg-transparent shadow-none py-1" placeholder="Email Address" />
                    </div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-2">Security PIN / Password</label>
                    <div class="input-group border rounded-3 bg-light p-1">
                        <span class="input-group-text bg-transparent border-0"><i class="fi fi-rr-lock text-muted"></i></span>
                        <input id="password" type="password" class="form-control border-0 bg-transparent shadow-none py-1" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-2">Select Role</label>
                    <div class="input-group border rounded-3 bg-light p-1">
                        <span class="input-group-text bg-transparent border-0"><i class="fi fi-rr-briefcase text-muted"></i></span>
                        <select id="role" class="form-select border-0 bg-transparent shadow-none py-1 custom-dropdown" style="font-size: 0.9rem;">
                            <option value="student">Student</option>
                            <option value="employee">Employee</option>
                            <option value="event_attendee">Event Attendee</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="mt-auto">
                <div id="message" class="mb-2 text-center fw-medium small"></div>
                <button class="btn btn-primary btn-lg w-100 py-3 btn-subtle border-0 shadow-sm" onclick="register()">
                    <i class="fi fi-rr-id-badge me-2"></i> Complete Registration
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .input-group:focus-within {
        border-color: var(--primary) !important;
        background: white !important;
    }
</style>

@section Scripts {
    <script src="~/js/register.js"></script>
    <script>
        const video = document.getElementById('video');
        
        if (navigator.mediaDevices.getUserMedia) {
            navigator.mediaDevices.getUserMedia({ video: { width: 1280, height: 720 } })
                .then(function (stream) {
                    video.srcObject = stream;
                })
                .catch(function (error) {
                    document.getElementById('message').innerHTML = '<i class="fi fi-rr-camera-slash me-2"></i> Camera access denied.';
                    document.getElementById('message').className = "mt-4 text-center text-danger";
                });
        }

    </script>
}
