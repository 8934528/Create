@page
@model frontend_web.Pages.RegisterModel
@{
    ViewData["Title"] = "Register Face";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 card shadow-lg p-4">
            <h2 class="text-center mb-4">Face Registration</h2>
            
            <div class="form-group mb-3">
                <label>Full Name</label>
                <input id="name" class="form-control" placeholder="John Doe" />
            </div>
            
            <div class="form-group mb-3">
                <label>Email</label>
                <input id="email" type="email" class="form-control" placeholder="john@example.com" />
            </div>
            
            <div class="form-group mb-3">
                <label>Password</label>
                <input id="password" type="password" class="form-control" />
            </div>

            <div class="video-container text-center mb-3">
                <video id="video" width="100%" height="auto" autoplay class="rounded border"></video>
                <canvas id="canvas" style="display:none;"></canvas>
            </div>

            <button class="btn btn-primary w-100" onclick="register()">Register with Face</button>
            
            <div id="message" class="mt-3 text-center"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/register.js"></script>
    <script>
        const video = document.getElementById('video');
        
        if (navigator.mediaDevices.getUserMedia) {
            navigator.mediaDevices.getUserMedia({ video: true })
                .then(function (stream) {
                    video.srcObject = stream;
                })
                .catch(function (error) {
                    console.log("Something went wrong!");
                    document.getElementById('message').innerText = "Camera access denied.";
                });
        }
    </script>
}
