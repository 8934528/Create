@page
@model frontend_web.Pages.AttendanceModel
@{
    ViewData["Title"] = "Real-Time Face Attendance";
}

<div class="container-fluid p-0 vh-100 overflow-hidden bg-white">
    <div class="row g-0 h-100">
        <!-- Left Column: Scanner -->
        <div class="col-lg-7 bg-dark position-relative d-flex align-items-center justify-content-center p-0 reduced-height-col overflow-hidden">
            <video id="video" class="w-100 h-100" style="object-fit: cover; transform: scaleX(-1);" autoplay muted></video>
            <canvas id="canvas" style="display:none;"></canvas>
            
            <!-- Scanner Overlay -->
            <div id="scan-overlay" class="position-absolute top-50 start-50 translate-middle w-75 h-75 border rounded-4" style="pointer-events: none; border: 2px dashed rgba(255, 255, 255, 0.4) !important;">
                <div class="scanner-line"></div>
            </div>

            <div class="position-absolute top-0 start-0 p-4">
                <span id="signalr-badge">
                    <span class="badge bg-dark bg-opacity-50 text-white border border-secondary px-3 py-2 rounded-pill shadow-sm" id="signalr-status" style="backdrop-filter: blur(4px);">
                        <i class="fi fi-rr-refresh me-1"></i> INITIALIZING...
                    </span>
                </span>
            </div>
        </div>

        <!-- Right Column: Info & Controls -->
        <div class="col-lg-5 d-flex flex-column p-5 bg-white border-start reduced-height-col">
            <div class="mb-4 d-none d-lg-block">
                <h2 class="fw-bold text-primary mb-1">
                    <i class="fi fi-rr-expand me-2"></i> Live Scanner
                </h2>
                <p class="text-muted small">Automatic face identification system active.</p>
            </div>

            <div class="flex-grow-1">
                <div id="status-container" class="alert alert-info border-0 rounded-3 text-center fw-medium py-3 mb-4" role="alert">
                    <i class="fi fi-rr-info me-2"></i> Preparing secure connection...
                </div>

                <div class="card card-minimal border-0 bg-light p-4 mb-4 d-none d-lg-block">
                    <h6 class="fw-bold small text-uppercase text-muted mb-3">Instructions</h6>
                    <ul class="small text-muted ps-3 mb-0">
                        <li class="mb-2">Position your face within the scanner frame.</li>
                        <li class="mb-2">Ensure adequate lighting on your face.</li>
                        <li>Keep still for 1-2 seconds for detection.</li>
                    </ul>
                </div>
            </div>

            <div class="mt-auto">
                <button id="btn-manual" class="btn btn-primary btn-lg w-100 py-3 btn-subtle border-0 shadow-sm" onclick="captureManual()">
                    <i class="fi fi-rr-fingerprint me-2"></i> Force Manual Scan
                </button>
                <div class="text-center mt-3 d-none d-lg-block">
                    <small class="text-muted"><i class="fi fi-rr-shield-check me-1"></i> Secure Biometric Link</small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .scanner-line {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--primary), transparent);
        box-shadow: 0 0 10px var(--primary);
        animation: scan 4s linear infinite;
        opacity: 0.4;
    }

    @@keyframes scan {
        0% { top: 0; }
        100% { top: 100%; }
    }

    #video {
        background-color: #f1f1f1;
    }

    .alert-success { background-color: #e8f5e9 !important; color: #2e7d32 !important; }
    .alert-warning { background-color: #fff8e1 !important; color: #f57f17 !important; }
    .alert-danger  { background-color: #ffebee !important; color: #c62828 !important; }
    .alert-info    { background-color: #e3f2fd !important; color: #1565c0 !important; }
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        const video = document.getElementById("video");
        const canvas = document.getElementById("canvas");
        const statusContainer = document.getElementById("status-container");
        const signalrStatus = document.getElementById("signalr-status");

        const EVENT_ID = "@(ViewData["EventId"] ?? "00000000-0000-0000-0000-000000000000")";
        const API_BASE = "http://localhost:5242";

        let prevImage = null;
        let scanning = false;

        const connection = new signalR.HubConnectionBuilder()
            .withUrl(`${API_BASE}/attendanceHub`, { withCredentials: true })
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveStatus", message => {
            const isSuccess = message.includes("[Success]") || message.includes("Welcome");
            const isWarning = message.includes("[Info]") || message.includes("[Warning]");
            const isError   = message.includes("[Error]");

            statusContainer.className = "alert border-0 rounded-3 text-center fw-medium py-3 mb-4 " + 
                                      (isSuccess ? "alert-success" : isWarning ? "alert-warning" : isError ? "alert-danger" : "alert-info");
            
            let icon = '<i class="fi fi-rr-info me-2"></i>';
            if (isSuccess) { 
                icon = '<i class="fi fi-rr-check me-2"></i>'; 
                showToast("Attendance", message.replace("[Success] ", ""), "success"); 
            }
            if (isWarning) icon = '<i class="fi fi-rr-warning me-2"></i>';
            if (isError) icon = '<i class="fi fi-rr-cross-circle me-2"></i>';
            
            statusContainer.innerHTML = icon + message.replace(/\[.*?\] /g, "");
        });

        connection.onreconnecting(() => {
            signalrStatus.className = "badge bg-warning text-dark border px-3 py-2 rounded-pill";
            signalrStatus.innerHTML = '<i class="fi fi-rr-refresh me-1"></i> RECONNECTING...';
        });

        connection.onreconnected(() => {
            signalrStatus.className = "badge bg-danger text-white border px-3 py-2 rounded-pill";
            signalrStatus.innerHTML = '<i class="fi fi-rr-check me-1"></i> CONNECTED • LIVE';
        });

        connection.onclose(() => {
            signalrStatus.className = "badge bg-danger text-white border px-3 py-2 rounded-pill";
            signalrStatus.innerHTML = '<i class="fi fi-rr-circle-cross me-1"></i> OFFLINE';
        });

        connection.start()
            .then(() => {
                signalrStatus.className = "badge bg-success text-white border px-3 py-2 rounded-pill";
                signalrStatus.innerHTML = '<i class="fi fi-rr-check me-1"></i> CONNECTED • LIVE';
            })
            .catch(err => {
                signalrStatus.className = "badge bg-danger text-white border px-3 py-2 rounded-pill";
                signalrStatus.innerHTML = '<i class="fi fi-rr-circle-cross me-1"></i> OFFLINE';
            });

        navigator.mediaDevices.getUserMedia({ video: { width: 1280, height: 720 } })
            .then(stream => {
                video.srcObject = stream;
                statusContainer.innerHTML = '<i class="fi fi-rr-smile me-2"></i> System Ready — Automatic Scanning Active';
                setInterval(captureFrame, 1500);
            })
            .catch(err => {
                statusContainer.className = "alert alert-danger border-0 rounded-3 text-center fw-medium py-3 mb-4";
                statusContainer.innerHTML = '<i class="fi fi-rr-camera-slash me-2"></i> Error: Camera access denied. Check browser permissions.';
            });

        function getFrameBase64() {
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            if (canvas.width === 0) return null;
            canvas.getContext("2d").drawImage(video, 0, 0);
            return canvas.toDataURL("image/jpeg", 0.7);
        }

        async function captureFrame() {
            if (scanning) return;
            const image = getFrameBase64();
            if (!image) return;
            await sendScan(image);
        }

        async function captureManual() {
            const image = getFrameBase64();
            if (!image) return;
            statusContainer.innerHTML = '<i class="fi fi-rr-loading me-2"></i> Processing manual scan...';
            await sendScan(image);
        }

        async function sendScan(image) {
            scanning = true;
            try {
                await fetch(`${API_BASE}/api/attendance/scan`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ image: image, prevImage: prevImage, eventId: EVENT_ID })
                });
            } catch (err) {
                console.error("Scan error:", err);
            } finally {
                prevImage = image;
                scanning = false;
            }
        }
    </script>
}
