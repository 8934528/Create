@page
@model IndexModel
@{
    ViewData["Title"] = "Next-Gen Face Recognition";
}

<div class="hero-section text-center py-5 mb-5">
    <div class="container py-5">
        <h1 class="display-3 fw-bold mb-3" style="background: linear-gradient(135deg, #fff 0%, #94a3b8 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
            Secure. Fast. Intelligent.
        </h1>
        <p class="lead mb-4 mx-auto" style="max-width: 700px; color: var(--muted);">
            Experience the future of attendance tracking with real-time AI face recognition and advanced anti-spoofing technology.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-page="/Attendance" class="btn btn-primary btn-lg px-5 py-3 shadow-lg" style="background: var(--accent); border: none; border-radius: 12px; font-weight: 600;">
                Launch Scanner
            </a>
            <a asp-page="/Register" class="btn btn-outline-light btn-lg px-5 py-3" style="border-radius: 12px; border-color: var(--border); font-weight: 600;">
                Get Started
            </a>
        </div>
    </div>
</div>

<div class="row g-4 py-5">
    <div class="col-md-4">
        <div class="feature-card p-4 h-100 rounded-4" style="background: var(--surface); border: 1px solid var(--border); backdrop-filter: blur(8px);">
            <div class="feature-icon mb-3" style="font-size: 2.5rem;">🎭</div>
            <h3 class="h4 fw-bold">AI Face ID</h3>
            <p style="color: var(--muted);">Advanced neural networks identify faces in milliseconds with industry-leading accuracy.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card p-4 h-100 rounded-4" style="background: var(--surface); border: 1px solid var(--border); backdrop-filter: blur(8px);">
            <div class="feature-icon mb-3" style="font-size: 2.5rem;">🛡️</div>
            <h3 class="h4 fw-bold">Anti-Spoofing</h3>
            <p style="color: var(--muted);">Liveness detection ensures that only real people can check in, preventing photo fraud.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card p-4 h-100 rounded-4" style="background: var(--surface); border: 1px solid var(--border); backdrop-filter: blur(8px);">
            <div class="feature-icon mb-3" style="font-size: 2.5rem;">📊</div>
            <h3 class="h4 fw-bold">Live Analytics</h3>
            <p style="color: var(--muted);">Real-time dashboard provides instant insights into attendance trends and user data.</p>
        </div>
    </div>
</div>

<style>
    .hero-section {
        position: relative;
        overflow: hidden;
    }
    
    .feature-card {
        transition: transform 0.3s ease, border-color 0.3s ease;
    }
    
    .feature-card:hover {
        transform: translateY(-10px);
        border-color: var(--accent);
    }
</style>
