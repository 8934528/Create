@page
@model IndexModel
@{
    ViewData["Title"] = "Next-Gen Face Recognition";
}

<div class="hero-section bg-white border-bottom py-2">
    <div class="container-fluid px-5">
        <div class="row align-items-center py-3">
            <div class="col-lg-7">
                <h1 class="display-4 fw-bold mb-3" style="color: var(--primary); letter-spacing: -0.02em;">
                    Intelligent Attendance <br/> for Modern Teams.
                </h1>
                <p class="lead mb-4 text-muted" style="max-width: 550px; font-size: 1rem; opacity: 0.8;">
                    Secure, fast, and effortless. Our advanced AI face recognition system streamlines your workflow with enterprise-grade precision.
                </p>
                <div class="d-flex gap-2">
                    <a asp-page="/Attendance" class="btn btn-primary px-4 py-2 btn-subtle shadow-sm">
                        <i class="fi fi-rr-expand me-2"></i> Launch Scanner
                    </a>
                    <a asp-page="/Register" class="btn btn-outline-secondary px-4 py-2 btn-subtle">
                        <i class="fi fi-rr-user-add me-2"></i> Get Started
                    </a>
                </div>
            </div>
            <div class="col-lg-5 text-center d-none d-lg-block">
                <div class="p-4 bg-light rounded-circle d-inline-block shadow-sm">
                    <i class="fi fi-rr-face-smile text-primary" style="font-size: 5rem;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="features-section py-4 bg-light">
    <div class="container-fluid px-5">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="p-4 bg-white h-100 card-minimal border-0 shadow-sm">
                    <div class="mb-3 text-primary">
                        <i class="fi fi-rr-shield-check" style="font-size: 1.4rem;"></i>
                    </div>
                    <h3 class="h6 fw-bold">Secure Verification</h3>
                    <p class="text-muted small mb-0">Liveness detection ensures only real people are tracked, preventing spoofing attempts.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 bg-white h-100 card-minimal border-0 shadow-sm">
                    <div class="mb-3 text-secondary">
                        <i class="fi fi-rr-stats" style="font-size: 1.4rem;"></i>
                    </div>
                    <h3 class="h6 fw-bold">Real-time Analytics</h3>
                    <p class="text-muted small mb-0">Instant insights into attendance patterns with our professional live dashboard.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 bg-white h-100 card-minimal border-0 shadow-sm">
                    <div class="mb-3 text-info">
                        <i class="fi fi-rr-cloud-upload" style="font-size: 1.4rem;"></i>
                    </div>
                    <h3 class="h6 fw-bold">Cloud Sync</h3>
                    <p class="text-muted small mb-0">Data is securely stored and accessible from any device, anywhere, anytime.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hero-section {
        min-height: 40vh;
        display: flex;
        align-items: center;
    }
</style>

