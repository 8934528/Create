@page
@model IndexModel
@{
    ViewData["Title"] = "Next-Gen Face Recognition";
}

<div class="hero-section bg-white border-bottom py-5">
    <div class="container-fluid px-5">
        <div class="row align-items-center py-5">
            <div class="col-lg-6">
                <h1 class="display-3 fw-bold mb-4" style="color: var(--primary);">
                    Intelligent Attendance <br/> Made Simple.
                </h1>
                <p class="lead mb-5 text-muted" style="max-width: 600px;">
                    Streamline your workflow with our advanced AI face recognition system. Secure, fast, and designed for modern teams.
                </p>
                <div class="d-flex gap-3">
                    <a asp-page="/Attendance" class="btn btn-primary btn-lg px-5 py-3 btn-subtle shadow-sm">
                        <i class="fi fi-rr-camera me-2"></i> Launch Scanner
                    </a>
                    <a asp-page="/Register" class="btn btn-outline-secondary btn-lg px-5 py-3 btn-subtle">
                        Get Started
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center d-none d-lg-block">
                <div class="p-5 bg-light rounded-circle d-inline-block shadow-sm">
                    <i class="fi fi-rr-face-smile text-primary" style="font-size: 8rem;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="features-section py-5 bg-light">
    <div class="container-fluid px-5">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="p-4 bg-white h-100 card-minimal border-0 shadow-sm">
                    <div class="mb-3 text-primary">
                        <i class="fi fi-rr-shield-check" style="font-size: 2rem;"></i>
                    </div>
                    <h3 class="h5 fw-bold">Secure Verification</h3>
                    <p class="text-muted small mb-0">Advanced liveness detection prevents fraud and ensures only real people are tracked.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 bg-white h-100 card-minimal border-0 shadow-sm">
                    <div class="mb-3 text-secondary">
                        <i class="fi fi-rr-stats" style="font-size: 2rem;"></i>
                    </div>
                    <h3 class="h5 fw-bold">Real-time Analytics</h3>
                    <p class="text-muted small mb-0">Get instant insights into your team's attendance patterns with our live dashboard.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 bg-white h-100 card-minimal border-0 shadow-sm">
                    <div class="mb-3 text-info">
                        <i class="fi fi-rr-cloud-upload" style="font-size: 2rem;"></i>
                    </div>
                    <h3 class="h5 fw-bold">Cloud Sync</h3>
                    <p class="text-muted small mb-0">Your data is safely stored and accessible from any device, anywhere, anytime.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hero-section {
        min-height: 70vh;
        display: flex;
        align-items: center;
    }
</style>

