@page
@model frontend_web.Pages.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard — Attendance Analytics";
}

<div class="container-fluid py-5 bg-light min-vh-100">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-5 px-4">
        <div>
            <h1 class="fw-bold text-primary mb-0">
                <i class="fi fi-rr-stats me-2"></i> CREATE Analytics
            </h1>
            <p class="text-muted small mb-0">Real-time attendance insights</p>
        </div>
        <div class="text-end">
            <span id="last-updated" class="badge bg-white text-muted border px-3 py-2 rounded-pill shadow-sm">
                <i class="fi fi-rr-refresh me-1"></i> Loading...
            </span>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="row g-4 mb-5 px-4">
        <div class="col-md-4">
            <div class="p-4 bg-white card-minimal border-0 shadow-sm">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 bg-primary bg-opacity-10 rounded-3 me-3 text-primary">
                        <i class="fi fi-rr-users" style="font-size: 1.5rem;"></i>
                    </div>
                    <div class="stat-label text-uppercase text-muted fw-bold" style="font-size: 0.7rem; letter-spacing: 0.1em;">Registered Users</div>
                </div>
                <div class="stat-value h2 fw-bold text-dark mb-0" id="stat-users">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white card-minimal border-0 shadow-sm">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 bg-success bg-opacity-10 rounded-3 me-3 text-success">
                        <i class="fi fi-rr-calendar-check" style="font-size: 1.5rem;"></i>
                    </div>
                    <div class="stat-label text-uppercase text-muted fw-bold" style="font-size: 0.7rem; letter-spacing: 0.1em;">Total Check-ins</div>
                </div>
                <div class="stat-value h2 fw-bold text-dark mb-0" id="stat-total">
                    <div class="spinner-border spinner-border-sm text-success" role="status"></div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white card-minimal border-0 shadow-sm">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 bg-info bg-opacity-10 rounded-3 me-3 text-info">
                        <i class="fi fi-rr-clock" style="font-size: 1.5rem;"></i>
                    </div>
                    <div class="stat-label text-uppercase text-muted fw-bold" style="font-size: 0.7rem; letter-spacing: 0.1em;">Today's Check-ins</div>
                </div>
                <div class="stat-value h2 fw-bold text-dark mb-0" id="stat-today">
                    <div class="spinner-border spinner-border-sm text-info" role="status"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart Section -->
    <div class="px-4">
        <div class="bg-white p-5 card-minimal border-0 shadow-sm">
            <h2 class="h5 fw-bold mb-4">
                <i class="fi fi-rr-chart-histogram me-2 text-primary"></i> 7-Day Attendance Trend
            </h2>
            <div style="height: 400px;">
                <canvas id="attendanceChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <script>
        const API_BASE = "http://localhost:5242";
        let chartInstance = null;

        function formatDate(dateStr) {
            const d = new Date(dateStr + "T00:00:00");
            return d.toLocaleDateString("en-ZA", { weekday: "short", month: "short", day: "numeric" });
        }

        async function loadDashboard() {
            try {
                const res = await fetch(`${API_BASE}/api/attendance/report`);
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();

                document.getElementById("stat-users").innerText = data.totalUsers.toLocaleString();
                document.getElementById("stat-total").innerText = data.totalAttendance.toLocaleString();
                document.getElementById("stat-today").innerText = data.todayAttendance.toLocaleString();

                document.getElementById("last-updated").innerHTML =
                    '<i class="fi fi-rr-refresh me-1"></i> Updated ' + new Date().toLocaleTimeString();

                const labels = data.last7Days.map(d => formatDate(d.date));
                const counts = data.last7Days.map(d => d.count);

                const ctx = document.getElementById("attendanceChart").getContext("2d");

                if (chartInstance) chartInstance.destroy();

                chartInstance = new Chart(ctx, {
                    type: "bar",
                    data: {
                        labels,
                        datasets: [{
                            label: "Check-ins",
                            data: counts,
                            backgroundColor: "rgba(92, 107, 192, 0.7)",
                            borderColor: "rgba(92, 107, 192, 1)",
                            borderWidth: 0,
                            borderRadius: 8,
                            barThickness: 40
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: "#fff",
                                titleColor: "#334155",
                                bodyColor: "#64748b",
                                borderColor: "#e2e8f0",
                                borderWidth: 1,
                                padding: 12,
                                boxPadding: 6,
                                usePointStyle: true,
                                callbacks: {
                                    label: ctx => ` ${ctx.parsed.y} check-in${ctx.parsed.y !== 1 ? "s" : ""}`
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: { color: "#94a3b8", font: { family: "Segoe UI", size: 12 } }
                            },
                            y: {
                                beginAtZero: true,
                                grid: { color: "#f1f5f9" },
                                ticks: {
                                    color: "#94a3b8",
                                    font: { family: "Segoe UI", size: 12 },
                                    stepSize: 1,
                                    precision: 0
                                },
                                border: { display: false }
                            }
                        }
                    }
                });

            } catch (err) {
                console.error("Dashboard load error:", err);
                document.getElementById("last-updated").innerHTML = '<i class="fi fi-rr-warning me-1"></i> Failed to update';
            }
        }

        loadDashboard();
        setInterval(loadDashboard, 30_000);
    </script>
}
